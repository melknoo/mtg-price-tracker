{
  "name": "mtg-price-tracker",
  "version": "0.1.0",
  "description": "Cardmarket price tracker with ntfy push notifications",
  "type": "module",
  "scripts": {
    "test:scraper": "node test-scraper.js",
    "test:dump": "node test-scraper.js --dump-html",
    "test:persist": "node test-scraper.js --persist",
    "test:config": "node test-scraper.js --config",
    "test:config:persist": "node test-scraper.js --config 0 --persist",
    "history": "node history.js",
    "test:detector": "node test-detector.js",
    "test:notify": "node test-notifier.js",
    "cron": "node cron-tracker.js",
    "cron:dry": "node cron-tracker.js --dry-run",
    "cron:verbose": "node cron-tracker.js --verbose",
    "cards:web": "node web-ui.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "cheerio": "^1.0.0",
    "puppeteer": "^23.11.1",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2"
  },
  "engines": {
    "node": ">=20"
  }
}
